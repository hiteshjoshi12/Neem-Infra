# Saudagar Properties - cPanel Apache Reverse Proxy & Host Canonicalization Configuration
# Location: Project Root / public_html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Host & Protocol Canonicalization (Single-Hop 301 to https://saudagarproperties.com)
  # Consolidates both http->https and www->apex into exactly ONE hop
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.saudagarproperties\.com$ [NC]
  RewriteRule ^(.*)$ https://saudagarproperties.com/$1 [R=301,L,NE]

  # 2. Dead WordPress RSS / Atom Feeds (410 Gone)
  # Removes crawl bloat from search engines immediately without redirect chains
  RewriteRule ^feed/?$ - [G,L]
  RewriteRule ^.+/feed/?.*$ - [G,L]
  RewriteRule ^search/.+/feed/?.*$ - [G,L]

  # 3. Security Headers
  <IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
  </IfModule>
</IfModule>
